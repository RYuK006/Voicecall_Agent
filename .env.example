# Indic Voice Agent Environment Configuration
# Add any of the following API keys to enable superhuman conversational intelligence:

# Option A: Groq Cloud (Free Llama 3 - get from https://console.groq.com)
GROQ_API_KEY=

# Option B: xAI Grok (Grok-beta / Grok-2 - get from https://console.x.ai)
GROK_API_KEY=

# Option C: Google Gemini Flash (Free 15 RPM - get from https://aistudio.google.com)
GEMINI_API_KEY=

# Option D: Twilio Digital Telephony (Free $15 trial credits - zero microphone, 100% digital)
# Register your personal phone number under "Verified Caller IDs" to make your mobile number show on recipient's screen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFIED_CALLER_ID=

# Server Port
PORT=8000
HOST=127.0.0.1
